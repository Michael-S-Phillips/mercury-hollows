        NOT_APPLICABLE_CONSTANT = -999.999
        DESCRIPTION             = "The mean value in the CCD dark strip.  This
                                   is a measure of the dark current even if
                                   the rest of the CCD is illuminated."
    END_OBJECT              = COLUMN
    OBJECT                  = COLUMN
        COLUMN_NUMBER           = 67
        NAME                    = "MINIMUM"
        DATA_TYPE               = ASCII_REAL
        START_BYTE              = 999
        BYTES                   = 19
        DESCRIPTION             = "The lowest value within the exposed area of
                                   the CCD."
    END_OBJECT              = COLUMN
    OBJECT                  = COLUMN
        COLUMN_NUMBER           = 68
        NAME                    = "MAXIMUM"
        DATA_TYPE               = ASCII_REAL
        START_BYTE              = 1019
        BYTES                   = 18
        DESCRIPTION             = "The highest value within the exposed area
                                   of the CCD."
    END_OBJECT              = COLUMN
    OBJECT                  = COLUMN
        COLUMN_NUMBER           = 69
        NAME                    = "MEAN"
        DATA_TYPE               = ASCII_REAL
        START_BYTE              = 1038
        BYTES                   = 19
        DESCRIPTION             = "The arithmetic mean value within the
                                   exposed area of the CCD."
    END_OBJECT              = COLUMN
    OBJECT                  = COLUMN
        COLUMN_NUMBER           = 70
        NAME                    = "STANDARD_DEVIATION"
        DATA_TYPE               = ASCII_REAL
        START_BYTE              = 1058
        BYTES                   = 18
        DESCRIPTION             = "The standard deviation of the values within
                                   the exposed area of the CCD."
    END_OBJECT              = COLUMN
    OBJECT                  = COLUMN
        COLUMN_NUMBER           = 71
        NAME                    = "SATURATED_PIXEL_COUNT"
        DATA_TYPE               = ASCII_REAL
        START_BYTE              = 1077
        BYTES                   = 6
        DESCRIPTION             = "The number of pixels whose values indicate
                                   that the corresponding detector elements
                                   exceeded their linear response range. In
                                   the WAC (MESS:IMAGER=0) the 12-bit DN value
                                   where saturation occurs is approximately
                                   3600; in the NAC (MESS:IMAGER=1) it is
                                   approximately 3400."
    END_OBJECT              = COLUMN
END_OBJECT               = INDEX_TABLE
END
